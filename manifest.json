{
  "manifest_version": 2,
  "name": "FiltaQuilla",
  "description": "__MSG_extensionDescription__",
  "version": "6.3",
  "default_locale": "en",
  "author": "R Kent James, Axel Grude",
  "developer": {
    "name": "Axel Grude",
    "url": "https://quickfilters.quickfolders.org/filtaquilla.html"
  },
  "applications": {
    "gecko": {
      "id": "filtaquilla@mesquilla.com",
      "strict_min_version": "140.0",
      "strict_max_version": "157.*"
    }
  },
  "icons": {
    "32": "skin/filtaquilla-32.png",
    "64": "skin/filtaquilla-64.png"
  },
  "background": {
    "page": "filtaquilla-background.html"
  },
  "permissions": ["messagesRead", "menus", "notifications", "storage", "tabs", "accountsRead"],
  "browser_action": {
    "default_icon": {
      "32": "skin/filtaquilla-32.png",
      "64": "skin/filtaquilla-64.png"
    },
    "default_windows": ["normal"],
    "type": "menu",
    "allowed_spaces": ["mail", "settings"]
  },
  "experiment_apis": {
    "FiltaQuilla": {
      "schema": "content/api/FiltaQuilla/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["FiltaQuilla"]],
        "script": "content/api/FiltaQuilla/implementation.js"
      }
    },
    "WindowListener": {
      "schema": "content/api/WindowListener/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["WindowListener"]],
        "script": "content/api/WindowListener/implementation.js"
      }
    },
    "NotifyTools": {
      "schema": "content/api/NotifyTools/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["NotifyTools"]],
        "script": "content/api/NotifyTools/implementation.js",
        "events": ["startup"]
      }
    },
    "LegacyPrefs": {
      "schema": "content/api/LegacyPrefs/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["LegacyPrefs"]],
        "script": "content/api/LegacyPrefs/implementation.js"
      }
    },
    "DomContentScript": {
      "schema": "content/api/DomContentScript/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["DomContentScript"]],
        "script": "content/api/DomContentScript/implementation.js"
      }
    }
  },
  "options_ui": {
    "page": "html/fq-settings.html",
    "open_in_tab": true
  }
}
